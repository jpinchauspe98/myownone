{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "config/wsgi.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "config/wsgi.py" }
  ],
  "crons": [
    { "path": "/cron/enviar-recordatorios/", "schedule": "0 13 * * *" },
    { "path": "/cron/solicitar-resenas/", "schedule": "0 18 * * *" }
  ]
}
